# =============================================================================
# LendKit — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# KYC Service
# ---------------------------------------------------------------------------
KYC_SERVICE_PORT=8001
KYC_DB_URL=postgresql+asyncpg://lendkit:lendkit@postgres:5432/kyc
KYC_REDIS_URL=redis://redis:6379/0

# BIN lookup provider (binlist.net compatible API)
BIN_API_URL=https://lookup.binlist.net
BIN_API_KEY=

# Identity verification provider (e.g., Onfido, Smile ID, Smile Link)
IDENTITY_PROVIDER=smile_id   # smile_id | onfido | mock
IDENTITY_API_KEY=
IDENTITY_API_URL=

# Document validation
DOCUMENT_PROVIDER=mock       # mock | aws_textract | google_vision
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Credit Scoring Service
# ---------------------------------------------------------------------------
CREDIT_SCORING_SERVICE_PORT=8002
CREDIT_DB_URL=postgresql+asyncpg://lendkit:lendkit@postgres:5432/credit
SCORING_MODEL_PATH=/app/models/scoring_model.pkl
FUZZY_RULES_PATH=/app/rules/credit_rules.yaml

# ---------------------------------------------------------------------------
# Loan Origination Service
# ---------------------------------------------------------------------------
LOAN_ORIGINATION_SERVICE_PORT=8003
LOAN_DB_URL=postgresql+asyncpg://lendkit:lendkit@postgres:5432/loans

# Disbursement provider
DISBURSEMENT_PROVIDER=mock   # mock | flutterwave | paystack | stripe
DISBURSEMENT_API_KEY=
DISBURSEMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Repayment Service
# ---------------------------------------------------------------------------
REPAYMENT_SERVICE_PORT=8004
REPAYMENT_DB_URL=postgresql+asyncpg://lendkit:lendkit@postgres:5432/repayment

# Default collection settings
GRACE_PERIOD_DAYS=3
DEFAULT_PENALTY_RATE=0.02    # 2% daily penalty after grace period

# ---------------------------------------------------------------------------
# Message Queue (Kafka / Redis Streams)
# ---------------------------------------------------------------------------
EVENT_BACKEND=redis          # redis | kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
REDIS_STREAM_URL=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Shared Infrastructure
# ---------------------------------------------------------------------------
POSTGRES_USER=lendkit
POSTGRES_PASSWORD=lendkit
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

# API Gateway / JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Tracing (OpenTelemetry)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=lendkit
