# =============================================================================
# LendKit — Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Shared Infrastructure
# ---------------------------------------------------------------------------
POSTGRES_USER=lendkit
POSTGRES_PASSWORD=lendkit
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# API Gateway  (:8000)
# ---------------------------------------------------------------------------
GATEWAY_PORT=8000
JWT_SECRET_KEY=change-me-use-long-random-string-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_IP_PER_MINUTE=120
RATE_LIMIT_PER_TENANT_PER_MINUTE=600

# Tenant API keys (one per tenant) — format: TENANT_{TENANT_ID_UPPER}_API_KEY
# Example for tenant "acme":
# TENANT_ACME_API_KEY=my-secret-api-key

# ---------------------------------------------------------------------------
# KYC Service  (:8001)
# ---------------------------------------------------------------------------
KYC_PORT=8001
IDENTITY_PROVIDER=mock        # mock | smile_id | onfido
DOCUMENT_PROVIDER=mock        # mock | aws_textract | google_vision
EVENT_BACKEND=redis

# Smile ID (if IDENTITY_PROVIDER=smile_id)
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=

# AWS Textract (if DOCUMENT_PROVIDER=aws_textract)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Credit Scoring Service  (:8002)
# ---------------------------------------------------------------------------
CREDIT_PORT=8002

# ---------------------------------------------------------------------------
# Loan Origination Service  (:8003)
# ---------------------------------------------------------------------------
LOAN_PORT=8003

# ---------------------------------------------------------------------------
# Repayment Tracking Service  (:8004)
# ---------------------------------------------------------------------------
REPAYMENT_PORT=8004

# ---------------------------------------------------------------------------
# Disbursement Service  (:8005)
# ---------------------------------------------------------------------------
DISBURSEMENT_PORT=8005
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# ---------------------------------------------------------------------------
# Notification Service  (:8006)
# ---------------------------------------------------------------------------
NOTIFICATION_PORT=8006

# Termii SMS
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=LendKit
TERMII_CHANNEL=generic

# SendGrid Email
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Support contact (used in notification templates)
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=+2348001234567

# ---------------------------------------------------------------------------
# Collections Service  (:8007)
# ---------------------------------------------------------------------------
COLLECTIONS_PORT=8007

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=lendkit
